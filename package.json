{
  "name": "dsh-trace-inspect",
  "version": "0.8.0",
  "description": "Trace-inspector sidebar tab for dsh-better-sidebar: fold a session into user turns and expand any tool step in place — full arguments (JSON tree), tool results rendered as Markdown with a raw fallback, session-authorized image thumbnails, error details, on-demand untruncated payloads and a zoomed reading view — parallel tool-call batches grouped by assistant step, while keeping jump-back into the conversation | DSH 轮次轨迹侧边栏（详情增强版）：按轮次折叠会话，可就地展开任一步查看完整参数（JSON 树）、结果（Markdown 渲染/原文）、会话授权缩略图、错误详情与按需完整内容，并带放大阅读浮层，按助手步骤分组展示并行工具调用，同时保留一键定位回对话原位",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepack": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pack": "pnpm pack",
    "check:lib": "node scripts/check-lib.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "dsh-better-sidebar": ">=0.17.0",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "dsh-better-sidebar": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@11.8.0",
  "license": "MIT",
  "author": "Andor <zyfsta@outlook.com>",
  "contributors": [
    "xx529 (https://github.com/xx529)"
  ],
  "homepage": "https://github.com/xx529/dsh-trace-inspect",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xx529/dsh-trace-inspect.git"
  },
  "bugs": {
    "url": "https://github.com/xx529/dsh-trace-inspect/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "cordis",
    "webui",
    "better-sidebar",
    "trace-inspect",
    "turn-outline",
    "trajectory",
    "outline",
    "inspector",
    "sidebar"
  ]
}
